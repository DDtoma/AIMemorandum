import { Button, ComboBox, HorizontalBox, LineEdit, ListView, ScrollView, TextEdit, VerticalBox } from "std-widgets.slint";

export struct ItemRowData {
    id: string,
    title: string,
    state: string,
    waiting-reason: string,
    updated-at: string,
    synchronized: bool,
}

export struct AttachmentData {
    id: string,
    mime: string,
}

export component ItemsWindow inherits Window {
    title: "我的记录";
    width: 980px;
    height: 640px;
    in property <[ItemRowData]> rows: [];
    in property <[AttachmentData]> attachments: [];
    in-out property <int> filter: 0;
    in property <string> summary: "";
    in property <string> selected-id: "";
    in property <bool> has-selected: false;
    in-out property <string> selected-title: "";
    in-out property <string> selected-body: "";
    in property <string> selected-state: "";
    in property <bool> dirty: false;
    in property <bool> synchronized: true;
    in property <string> error: "";
    callback refresh();
    callback select(string);
    callback filter-changed(int);
    callback detail-changed(string, string);
    callback save();
    callback complete(string);
    callback reopen(string);
    callback remove(string);
    callback remind(string);
    callback open-attachment(string, string);
    callback show-settings();

    HorizontalBox {
        padding: 12px;
        spacing: 12px;
        VerticalBox {
            width: 360px;
            spacing: 8px;
            HorizontalBox {
                Text { text: "我的记录"; font-size: 20px; font-weight: 700; horizontal-stretch: 1; }
                Button { text: "刷新"; clicked => root.refresh(); }
                Button { text: "设置"; clicked => root.show-settings(); }
            }
            ComboBox {
                model: ["全部", "待办", "等待中", "已完成"];
                current-index <=> root.filter;
                selected(_) => root.filter-changed(self.current-index);
            }
            Text { text: root.summary; color: #555555; }
            ListView {
                for row in root.rows: Rectangle {
                    height: 62px;
                    border-radius: 5px;
                    background: row.id == root.selected-id ? #e3f2fd : #f7f7f7;
                    TouchArea { clicked => root.select(row.id); }
                    VerticalBox {
                        padding: 8px;
                        spacing: 3px;
                        Text { text: row.title; overflow: elide; font-weight: 600; }
                        Text {
                            text: row.state + (row.waiting-reason != "" ? " · " + row.waiting-reason : "") + (row.synchronized ? "" : " · 待同步");
                            font-size: 11px;
                            color: #666666;
                            overflow: elide;
                        }
                    }
                }
            }
        }
        Rectangle {
            horizontal-stretch: 1;
            background: #ffffff;
            if !root.has-selected: Text { text: "选择一条记录查看详情"; color: #777777; }
            if root.has-selected: VerticalBox {
                padding: 8px;
                spacing: 9px;
                HorizontalBox {
                    Text { text: "记录详情"; font-size: 18px; font-weight: 700; horizontal-stretch: 1; }
                    if root.dirty: Text { text: "未保存"; color: #ef6c00; }
                    Text { text: root.synchronized ? "已同步" : "待同步"; color: #666666; }
                }
                LineEdit {
                    placeholder-text: "标题";
                    text <=> root.selected-title;
                    edited(value) => root.detail-changed(value, root.selected-body);
                }
                TextEdit {
                    vertical-stretch: 1;
                    placeholder-text: "正文";
                    text <=> root.selected-body;
                    edited(value) => root.detail-changed(root.selected-title, value);
                }
                Text { text: "状态：" + root.selected-state; color: #555555; }
                ScrollView {
                    height: 48px;
                    HorizontalBox {
                        spacing: 6px;
                        for attachment in root.attachments: Button {
                            text: "打开 " + attachment.mime;
                            clicked => root.open-attachment(root.selected-id, attachment.id);
                        }
                    }
                }
                if root.error != "": Text { text: root.error; color: #c62828; wrap: word-wrap; }
                HorizontalBox {
                    spacing: 7px;
                    Button { text: "保存修改"; primary: true; clicked => root.save(); }
                    if root.selected-state == "canceled": Button {
                        text: "重新打开";
                        clicked => root.reopen(root.selected-id);
                    }
                    if root.selected-state != "completed" && root.selected-state != "canceled": Button {
                        text: "完成";
                        clicked => root.complete(root.selected-id);
                    }
                    Button { text: "+2小时提醒"; clicked => root.remind(root.selected-id); }
                    Button { text: "删除"; clicked => root.remove(root.selected-id); }
                }
            }
        }
    }
}
